@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 0 0% 98%;
    --foreground: 0 0% 9%;
    --card: 0 0% 100%;
    --card-foreground: 0 0% 9%;
    --primary: 0 0% 9%;
    --primary-foreground: 0 0% 98%;
    --secondary: 0 0% 96%;
    --secondary-foreground: 0 0% 9%;
    --muted: 0 0% 96%;
    --muted-foreground: 0 0% 45%;
    --accent: 0 0% 96%;
    --accent-foreground: 0 0% 9%;
    --destructive: 0 84% 60%;
    --destructive-foreground: 0 0% 98%;
    --border: 0 0% 90%;
    --input: 0 0% 90%;
    --ring: 0 0% 63%;
    --radius: 0.5rem;
  }

  .dark {
    --background: 240 10% 4%;
    --foreground: 0 0% 95%;
    --card: 240 6% 10%;
    --card-foreground: 0 0% 95%;
    --primary: 0 0% 95%;
    --primary-foreground: 240 6% 10%;
    --secondary: 240 5% 16%;
    --secondary-foreground: 0 0% 95%;
    --muted: 240 5% 16%;
    --muted-foreground: 240 5% 65%;
    --accent: 240 5% 18%;
    --accent-foreground: 0 0% 95%;
    --destructive: 0 63% 45%;
    --destructive-foreground: 0 0% 98%;
    --border: 240 4% 22%;
    --input: 240 4% 22%;
    --ring: 240 5% 54%;
  }

  * {
    @apply border-border;
  }

  body {
    @apply bg-background text-foreground antialiased;
    font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", system-ui, -apple-system, sans-serif;
  }
}

@layer utilities {
  .dark .bg-white {
    background-color: hsl(var(--card));
  }

  .dark .bg-neutral-50,
  .dark .bg-neutral-50\/50 {
    background-color: rgb(24 24 27);
  }

  .dark .bg-neutral-100 {
    background-color: rgb(39 39 42);
  }

  .dark .bg-neutral-200 {
    background-color: rgb(63 63 70);
  }

  .dark .bg-neutral-800 {
    background-color: rgb(228 228 231);
  }

  .dark .bg-neutral-900 {
    background-color: rgb(244 244 245);
  }

  .dark .text-neutral-950,
  .dark .text-neutral-900 {
    color: rgb(250 250 250);
  }

  .dark .text-neutral-800,
  .dark .text-neutral-700 {
    color: rgb(228 228 231);
  }

  .dark .text-neutral-600,
  .dark .text-neutral-500 {
    color: rgb(161 161 170);
  }

  .dark .text-neutral-400 {
    color: rgb(113 113 122);
  }

  .dark .text-neutral-300 {
    color: rgb(82 82 91);
  }

  .dark .text-neutral-50 {
    color: rgb(24 24 27);
  }

  .dark .border-neutral-100,
  .dark .border-neutral-200 {
    border-color: rgb(63 63 70);
  }

  .dark .hover\:bg-neutral-50:hover,
  .dark .hover\:bg-neutral-100:hover,
  .dark .hover\:bg-neutral-50\/50:hover,
  .dark .data-\[state\=selected\]\:bg-neutral-50[data-state="selected"] {
    background-color: rgb(39 39 42);
  }

  .dark .hover\:bg-neutral-200:hover {
    background-color: rgb(63 63 70);
  }

  .dark .hover\:bg-neutral-800:hover {
    background-color: rgb(212 212 216);
  }

  .dark .hover\:text-neutral-900:hover,
  .dark .hover\:text-neutral-700:hover {
    color: rgb(250 250 250);
  }

  .dark .placeholder\:text-neutral-400::placeholder {
    color: rgb(113 113 122);
  }

  .dark .bg-emerald-50,
  .dark .bg-emerald-50\/30,
  .dark .bg-emerald-50\/50 {
    background-color: rgb(6 78 59 / 0.28);
  }

  .dark .border-emerald-200 {
    border-color: rgb(5 150 105 / 0.5);
  }

  .dark .text-emerald-700,
  .dark .text-emerald-600,
  .dark .text-emerald-500 {
    color: rgb(110 231 183);
  }

  .dark .bg-amber-50,
  .dark .bg-amber-50\/50 {
    background-color: rgb(120 53 15 / 0.28);
  }

  .dark .border-amber-200 {
    border-color: rgb(217 119 6 / 0.5);
  }

  .dark .text-amber-700,
  .dark .text-amber-600 {
    color: rgb(252 211 77);
  }

  .dark .bg-red-50 {
    background-color: rgb(127 29 29 / 0.28);
  }

  .dark .border-red-200 {
    border-color: rgb(220 38 38 / 0.5);
  }

  .dark .text-red-700 {
    color: rgb(252 165 165);
  }
}
