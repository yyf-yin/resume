# 大模型配置
# 将此文件复制为 .env.local，再把 API Key 占位符替换为真实值。
# .env.local 已被 Git 忽略，不会提交到远程仓库。

# DeepSeek API Key（必填；未配置时项目自动使用 Mock 数据）
LLM_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek OpenAI 兼容接口
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_PROVIDER=deepseek

# 是否强制使用 Mock 模式
# 设置为 true 时，即使配置了 API Key 也不会调用真实大模型。
USE_MOCK_AI=false

# 生产环境默认不要记录可能包含简历内容的大模型原始响应。
AI_RESPONSE_LOG_ENABLED=false

# 单个来源在限流窗口内可调用 AI 接口的最大次数。
API_RATE_LIMIT_MAX=20

# 限流窗口长度，单位毫秒（默认 10 分钟）。
API_RATE_LIMIT_WINDOW_MS=600000

# API 请求体最大字节数（默认约 1MB）。
API_MAX_BODY_BYTES=1048576
